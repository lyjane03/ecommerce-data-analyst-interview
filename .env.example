# Copy to .env for local AI scoring. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_SCORING_MODEL=deepseek-flash

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TRANSCRIBE_MODEL=glm-asr-2512

# Optional when ffmpeg is not available on PATH.
FFMPEG_PATH=ffmpeg
HOST=127.0.0.1
PORT=4173
